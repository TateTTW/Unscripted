{
  "scenario_title": "The Larkspur Emerald",
  "genre": "HEIST",
  "intro_text": "Tonight Mrs. Delacroix throws a party, and her famous Larkspur Emerald sits in a safe somewhere in the house. You are here as a guest. Your partner Mags is waiting in the living room with the plan. Find the safe, work out its code, and get past Bruno, the guard who never leaves his post. Bring the emerald to Mags without getting caught. Don't hand it to the wrong person.",
  "npc_spawns": [
    {
      "entity_id": "mags",
      "display_name": "Mags",
      "sprite_index": 3,
      "placed_at": "living_room_2",
      "inspect_text": "Your partner in crime, sipping punch and looking bored. Nobody suspects a thing."
    },
    {
      "entity_id": "guard_bruno",
      "display_name": "Bruno",
      "sprite_index": 0,
      "placed_at": "office",
      "inspect_text": "A broad-shouldered guard in a navy uniform. He looks tired and a little grumpy."
    },
    {
      "entity_id": "andre",
      "display_name": "Chef Andre",
      "sprite_index": 5,
      "placed_at": "kitchen_1",
      "inspect_text": "The chef, juggling three pans and a temper."
    },
    {
      "entity_id": "delacroix",
      "display_name": "Mrs. Delacroix",
      "sprite_index": 1,
      "placed_at": "living_room_1",
      "inspect_text": "The hostess, a widow who loves telling stories about her late husband."
    }
  ],
  "item_definitions": [
    {
      "item_id": "lockpick",
      "display_name": "Lockpick",
      "inspect_text": "A thin steel pick. Good for one flimsy lock, maybe two.",
      "icon_category": "icon_tool"
    },
    {
      "item_id": "code_half_one",
      "display_name": "Code Card",
      "inspect_text": "A card from the desk drawer: '4 7 _ _'.",
      "icon_category": "icon_paper"
    },
    {
      "item_id": "code_half_two",
      "display_name": "Diary Page",
      "inspect_text": "The last page of Mr. Delacroix's diary: '_ _ 1 9'.",
      "icon_category": "icon_paper"
    },
    {
      "item_id": "safe_code",
      "display_name": "Safe Code",
      "inspect_text": "The full safe code: 4 7 1 9.",
      "icon_category": "icon_paper"
    },
    {
      "item_id": "tea_cup",
      "display_name": "Cup of Tea",
      "inspect_text": "Black tea, still hot. Bruno's favorite.",
      "icon_category": "icon_bottle"
    },
    {
      "item_id": "sleeping_draught",
      "display_name": "Sleeping Draught",
      "inspect_text": "A small brown bottle. 'Two drops for a full night's sleep.' The label is very clear.",
      "icon_category": "icon_bottle"
    },
    {
      "item_id": "drugged_tea",
      "display_name": "Drugged Tea",
      "inspect_text": "Bruno's tea, with a little something extra. It smells exactly like tea.",
      "icon_category": "icon_bottle"
    },
    {
      "item_id": "emerald",
      "display_name": "Larkspur Emerald",
      "inspect_text": "A green gem the size of a walnut. It glitters even in the dark.",
      "icon_category": "icon_trinket"
    }
  ],
  "interactions": [
    {
      "action": "TALK",
      "target_1": "mags",
      "target_2": null,
      "required_state": [{ "target_id": "mags", "state": "default" }],
      "events": [
        { "event": "show_dialogue", "text": "Mags: 'The emerald is in a safe behind the office bookcase. The code is split in two - half in the desk, half wherever old Mr. Delacroix kept his secrets.'" },
        { "event": "show_dialogue", "text": "Mags: 'Take this lockpick. And Bruno never leaves the office, so you will need to put him to sleep somehow.'" },
        { "event": "change_state", "target_id": "mags", "new_state": "briefed" },
        { "event": "spawn_item", "new_item_id": "lockpick" }
      ]
    },
    {
      "action": "TALK",
      "target_1": "mags",
      "target_2": null,
      "required_state": [],
      "events": [
        { "event": "show_dialogue", "text": "Mags: 'Bring me the emerald. Quietly.'" }
      ]
    },
    {
      "action": "USE",
      "target_1": "lockpick",
      "target_2": "office_desk",
      "required_state": [
        { "target_id": "lockpick", "state": null },
        { "target_id": "office_desk", "state": "default" }
      ],
      "events": [
        { "event": "show_dialogue", "text": "Click. In the drawer is a card with half a code: '4 7 _ _'. The lockpick snaps as you pull it free." },
        { "event": "change_state", "target_id": "office_desk", "new_state": "picked" },
        { "event": "destroy_item", "target_id": "lockpick" },
        { "event": "spawn_item", "new_item_id": "code_half_one" }
      ]
    },
    {
      "action": "TALK",
      "target_1": "delacroix",
      "target_2": null,
      "required_state": [],
      "events": [
        { "event": "show_dialogue", "text": "Mrs. Delacroix: 'My late husband trusted nobody. He wrote everything in his diary and slept with it under his pillow, the old fool.'" }
      ]
    },
    {
      "action": "INSPECT",
      "target_1": "bedroom_bed",
      "target_2": null,
      "required_state": [{ "target_id": "bedroom_bed", "state": "default" }],
      "events": [
        { "event": "show_dialogue", "text": "Under the pillow is a worn leather diary. The last page reads: '_ _ 1 9'. You tear it out." },
        { "event": "change_state", "target_id": "bedroom_bed", "new_state": "searched" },
        { "event": "spawn_item", "new_item_id": "code_half_two" }
      ]
    },
    {
      "action": "COMBINE",
      "target_1": "code_half_one",
      "target_2": "code_half_two",
      "required_state": [
        { "target_id": "code_half_one", "state": null },
        { "target_id": "code_half_two", "state": null }
      ],
      "events": [
        { "event": "show_dialogue", "text": "Put together: 4 7 1 9. The full safe code." },
        { "event": "spawn_item", "new_item_id": "safe_code" },
        { "event": "destroy_item", "target_id": "code_half_one" },
        { "event": "destroy_item", "target_id": "code_half_two" }
      ]
    },
    {
      "action": "TALK",
      "target_1": "andre",
      "target_2": null,
      "required_state": [{ "target_id": "andre", "state": "default" }],
      "events": [
        { "event": "show_dialogue", "text": "Andre: 'Bruno? He drinks black tea every hour or he gets grumpy. Here, take him this cup - I am far too busy.'" },
        { "event": "change_state", "target_id": "andre", "new_state": "served" },
        { "event": "spawn_item", "new_item_id": "tea_cup" }
      ]
    },
    {
      "action": "TALK",
      "target_1": "andre",
      "target_2": null,
      "required_state": [],
      "events": [
        { "event": "show_dialogue", "text": "Andre: 'Out of my kitchen, please! The souffle!'" }
      ]
    },
    {
      "action": "INSPECT",
      "target_1": "bathroom_bathtub",
      "target_2": null,
      "required_state": [{ "target_id": "bathroom_bathtub", "state": "default" }],
      "events": [
        { "event": "show_dialogue", "text": "On the edge of the tub sits a bottle of sleeping draught. Mrs. Delacroix must have trouble sleeping." },
        { "event": "change_state", "target_id": "bathroom_bathtub", "new_state": "searched" },
        { "event": "spawn_item", "new_item_id": "sleeping_draught" }
      ]
    },
    {
      "action": "COMBINE",
      "target_1": "sleeping_draught",
      "target_2": "tea_cup",
      "required_state": [
        { "target_id": "sleeping_draught", "state": null },
        { "target_id": "tea_cup", "state": null }
      ],
      "events": [
        { "event": "show_dialogue", "text": "You tip the whole bottle into the tea and give it a stir." },
        { "event": "spawn_item", "new_item_id": "drugged_tea" },
        { "event": "destroy_item", "target_id": "sleeping_draught" },
        { "event": "destroy_item", "target_id": "tea_cup" }
      ]
    },
    {
      "action": "TALK",
      "target_1": "guard_bruno",
      "target_2": null,
      "required_state": [{ "target_id": "guard_bruno", "state": "asleep" }],
      "events": [
        { "event": "show_dialogue", "text": "Bruno snores loudly, slumped against the wall." }
      ]
    },
    {
      "action": "TALK",
      "target_1": "guard_bruno",
      "target_2": null,
      "required_state": [],
      "events": [
        { "event": "show_dialogue", "text": "Bruno: 'The office is off limits during the party. I don't move from this spot. Not even for the restroom.'" }
      ]
    },
    {
      "action": "USE",
      "target_1": "tea_cup",
      "target_2": "guard_bruno",
      "required_state": [{ "target_id": "tea_cup", "state": null }],
      "events": [
        { "event": "show_dialogue", "text": "Bruno: 'Tea? Leave it there, I will drink it later.' Plain tea won't move him." }
      ]
    },
    {
      "action": "USE",
      "target_1": "sleeping_draught",
      "target_2": "guard_bruno",
      "required_state": [{ "target_id": "sleeping_draught", "state": null }],
      "events": [
        { "event": "show_dialogue", "text": "Bruno reads the label on the bottle, then looks at you very slowly. 'Were you planning to drug me?'" },
        { "event": "trigger_end", "outcome": "LOSS", "text": "Bruno marches you out the front door. The emerald stays in its safe, and Mags pretends she has never met you." }
      ]
    },
    {
      "action": "USE",
      "target_1": "drugged_tea",
      "target_2": "guard_bruno",
      "required_state": [
        { "target_id": "drugged_tea", "state": null },
        { "target_id": "guard_bruno", "state": "default" }
      ],
      "events": [
        { "event": "show_dialogue", "text": "Bruno gulps the tea gratefully. Within a minute his chin drops to his chest and he begins to snore." },
        { "event": "change_state", "target_id": "guard_bruno", "new_state": "asleep" },
        { "event": "destroy_item", "target_id": "drugged_tea" }
      ]
    },
    {
      "action": "INSPECT",
      "target_1": "office_bookcase",
      "target_2": null,
      "required_state": [{ "target_id": "office_bookcase", "state": "default" }],
      "events": [
        { "event": "show_dialogue", "text": "The bookcase stands a little away from the wall. Behind it is the steel face of a safe with a four-digit dial." }
      ]
    },
    {
      "action": "USE",
      "target_1": "safe_code",
      "target_2": "office_bookcase",
      "required_state": [
        { "target_id": "safe_code", "state": null },
        { "target_id": "office_bookcase", "state": "default" },
        { "target_id": "guard_bruno", "state": "default" }
      ],
      "events": [
        { "event": "show_dialogue", "text": "You reach behind the bookcase and spin the dial. Bruno turns at the click." },
        { "event": "trigger_end", "outcome": "LOSS", "text": "Bruno grabs your collar before the safe is open. The Larkspur Emerald stays put, and you spend the night in a cell." }
      ]
    },
    {
      "action": "USE",
      "target_1": "safe_code",
      "target_2": "office_bookcase",
      "required_state": [
        { "target_id": "safe_code", "state": null },
        { "target_id": "office_bookcase", "state": "default" },
        { "target_id": "guard_bruno", "state": "asleep" }
      ],
      "events": [
        { "event": "show_dialogue", "text": "4, 7, 1, 9. The safe swings open behind the bookcase, and the Larkspur Emerald glitters inside." },
        { "event": "change_state", "target_id": "office_bookcase", "new_state": "opened" },
        { "event": "spawn_item", "new_item_id": "emerald" }
      ]
    },
    {
      "action": "USE",
      "target_1": "emerald",
      "target_2": "mags",
      "required_state": [{ "target_id": "emerald", "state": null }],
      "events": [
        { "event": "show_dialogue", "text": "Mags pockets the jewel with a grin. 'Time to leave.'" },
        { "event": "trigger_end", "outcome": "WIN", "text": "You and Mags slip out into the night with the Larkspur Emerald. A perfect heist." }
      ]
    },
    {
      "action": "USE",
      "target_1": "emerald",
      "target_2": "delacroix",
      "required_state": [{ "target_id": "emerald", "state": null }],
      "events": [
        { "event": "trigger_end", "outcome": "LOSS", "text": "Mrs. Delacroix recognizes her emerald at once and screams for the police." }
      ]
    }
  ]
}
